# AI Strategy Consulting Assistant - Environment Configuration

# ============================================================
# Python/Streamlit Configuration
# ============================================================

# Server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Model cache directory (optional - defaults to ~/.cache/huggingface)
# HF_HOME=/path/to/cache

# ============================================================
# Next.js/Vercel Configuration
# ============================================================

# API Configuration (if adding backend APIs)
# NEXT_PUBLIC_API_URL=http://localhost:8501/api

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================================
# Development Settings
# ============================================================

# Enable debug logging
DEBUG=false

# Environment
NODE_ENV=development
